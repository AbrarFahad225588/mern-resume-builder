# Copy to .env and fill in. Never commit the real .env.

# --- Server ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
# Use a long random string. Rotating this invalidates every existing session.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_COOKIE_MAX_AGE=3600000

# --- MySQL ---
# Create the database and this user first:
#   mysql -u root -p < backend/db/bootstrap.sql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=resume_app
DB_PASSWORD=resume_app_pw
DB_NAME=resume_builder
DB_POOL_SIZE=10
